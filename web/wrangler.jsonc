{
  // Deploys the MacroPro web app on Cloudflare Workers. The React app itself is
  // fully static (the macro optimizer runs in the browser), served via Workers
  // Static Assets from the Vite build output. The one piece of server code is a
  // thin Worker (worker/index.ts) that serves the nutrition snapshots under
  // /data/* from an R2 bucket instead of shipping them in the bundle — see
  // .github/workflows/refresh-data.yml, which repopulates that bucket weekly.
  "name": "macropro",
  "compatibility_date": "2025-06-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Every request must reach the Worker, not just /data/*: worker/index.ts
    // also does the apex (macropro.food) -> canonical (www.macropro.food)
    // redirect, and that check can only ever run on requests the Worker
    // actually sees. Scoping this to ["/data/*"] (as it was before) let
    // /data/* correctly hit R2 first, but silently made the redirect dead
    // code — any other path, including "/", was served straight from static
    // assets without the Worker running at all, so the apex host kept
    // serving content directly instead of redirecting. `true` routes every
    // request through the Worker; index.ts's own checks (isDataRequest,
    // hostname, Sec-Fetch-Mode) still decide what happens from there.
    "run_worker_first": true
  },
  "r2_buckets": [
    { "binding": "STORAGE_NAME", "bucket_name": "macropro-data" }
  ]
}
