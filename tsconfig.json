{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "outDir": "./dist",
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // Papa John's ships a committed nutrition extract as JSON (its source PDF
    // can't be fetched or parsed at scrape time — see
    // src/scrapers/PapaJohns/README.md), which the scraper imports directly.
    "resolveJsonModule": true,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.json",
  ]
}